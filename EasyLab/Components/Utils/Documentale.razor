@using EasyLab.Models
@using EasyLab.Servizi
@using System.IO
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<SeaseTstContext> DbFactory
@inject AviTranscoderService AviTranscoder
@inject OfficeToPdfConverterService OfficeConverter
@inject IJSRuntime JSRuntime

@if (!string.IsNullOrEmpty(ChiaveSelezione))
{
    <div class="d-flex flex-column h-100" style="min-height:0;">
        <div class="p-2 border-bottom small text-muted flex-shrink-0 documentale-path-bar d-flex align-items-center justify-content-between gap-2">
            <span><strong>Percorso:</strong> @CartellaPath</span>
            <label class="btn-icon-plain mb-0 d-flex align-items-center flex-shrink-0"
                   style="@((!string.IsNullOrEmpty(CartellaPath) && !CaricamentoUpload) ? "cursor:pointer;" : "cursor:default;opacity:0.4;")"
                   title="Allega nuovo file">
                @if (CaricamentoUpload)
                {
                    <img src="/images/GIF_Criceto_2x.gif" style="width:20px;height:20px;" alt="Caricamento" />
                }
                else
                {
                    <img src="images/Allega32.svg" class="btn-icon-search" alt="Allega nuovo file" />
                }
                <InputFile OnChange="CaricaNuovoFile" disabled="@(string.IsNullOrEmpty(CartellaPath) || CaricamentoUpload)" style="display:none;" />
            </label>
        </div>
        <div class="flex-grow-1" style="min-height:0;">
            <DxSplitter Height="100%">
                <Panes>
                    <DxSplitterPane Size="200px" MinSize="120px">
                        <div style="height:100%; overflow-y:auto;">
                            @if (string.IsNullOrEmpty(CartellaPath))
                            {
                                <p class="text-muted small p-2">Percorso documentale non configurato.</p>
                            }
                            else if (File.Count == 0)
                            {
                                <p class="text-muted small p-2">Nessun file presente.</p>
                            }
                            else
                            {
                                <ul class="list-group list-group-flush">
                                    @foreach (var file in File)
                                    {
                                        <li class="list-group-item list-group-item-action d-flex align-items-center gap-1 py-1 px-2 small @(file == FileSelezionato ? "active" : "")"
                                            style="cursor:pointer;"
                                            @onclick="@(() => SelezionaFile(file))"
                                            @ondblclick="@(() => ApriInNuovaScheda(file))">
                                            <img src="images/@IconaFile(file)" style="width:16px;height:16px;flex-shrink:0;" alt="" />
                                            <span class="text-truncate">@file</span>
                                        </li>
                                    }
                                </ul>
                            }
                        </div>
                    </DxSplitterPane>
                    <DxSplitterPane MinSize="200px">
                        <div class="p-2 position-relative" style="height:100%; overflow:auto;">
                            @if (FileSelezionato == null)
                            {
                                <p class="text-muted">Nessun file selezionato.</p>
                            }
                            else if (EImmagine(FileSelezionato))
                            {
                                <img src="@FileUrl(FileSelezionato)" style="max-width:100%; max-height:100%;" @onload="FineCaricamento" @onerror="FineCaricamentoConErrore" />
                            }
                            else if ((EPdf(FileSelezionato) || EOffice(FileSelezionato)) && !ErroreAnteprima)
                            {
                                <iframe src="@FileUrl(FileSelezionato)" style="width:100%; height:100%; border:none;" @onload="FineCaricamento"></iframe>
                            }
                            else if (ETesto(FileSelezionato))
                            {
                                @if (TestoAnteprima != null)
                                {
                                    <pre class="small" style="white-space:pre-wrap; word-break:break-word;">@TestoAnteprima</pre>
                                }
                            }
                            else if (EVideo(FileSelezionato) && !ErroreAnteprima)
                            {
                                <video @key="FileSelezionato" controls autoplay style="max-width:100%; max-height:100%;" @onloadeddata="FineCaricamento" @onerror="FineCaricamentoConErrore">
                                    <source src="@FileUrl(FileSelezionato)" type="@ContentType(FileSelezionato)" />
                                </video>
                            }
                            else if (EAudio(FileSelezionato))
                            {
                                <audio @key="FileSelezionato" controls autoplay style="width:100%;" @onloadeddata="FineCaricamento" @onerror="FineCaricamentoConErrore">
                                    <source src="@FileUrl(FileSelezionato)" type="@ContentType(FileSelezionato)" />
                                </audio>
                            }
                            else
                            {
                                <div class="d-flex flex-column align-items-center justify-content-center h-100 gap-2">
                                    <img src="images/@IconaFile(FileSelezionato)" style="width:64px;height:64px;" alt="" />
                                    <span>@FileSelezionato</span>
                                    <a class="btn btn-sm btn-outline-secondary" href="@FileUrl(FileSelezionato, scarica: true)" data-enhance-nav="false">Scarica</a>
                                    <span class="text-muted small">Anteprima non disponibile per questo tipo di file.</span>
                                </div>
                            }
                            @if (CaricamentoAnteprima)
                            {
                                <div class="position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center bg-white bg-opacity-75">
                                    <img src="/images/GIF_Criceto_2x.gif" alt="Caricamento" style="width:64px;height:64px;" />
                                </div>
                            }
                            @if (ErroreAnteprima)
                            {
                                <p class="text-muted">Impossibile visualizzare il file "@FileSelezionato".</p>
                            }
                        </div>
                    </DxSplitterPane>
                </Panes>
            </DxSplitter>
        </div>
    </div>
}
else
{
    <p class="text-muted p-3">Nessun elemento selezionato.</p>
}

@code {
    // IdClasse della tabella doc.Classi_Path (es. 2 = Materiale, 3 = Prodotto, 7 = Commessa).
    [Parameter, EditorRequired] public int IdClasse { get; set; }

    // Suffisso della cartella <idBrand>_<Identificatore> da cercare (Parte per gli articoli,
    // NrScheda per le commesse).
    [Parameter] public string? Identificatore { get; set; }

    // Prefisso idBrand usato solo per comporre il nome di una cartella nuova (nella ricerca di
    // una cartella gia' esistente l'idBrand viene ignorato, vedi CaricaFile).
    [Parameter] public int? IdBrand { get; set; }

    // Cambia ogni volta che l'elemento selezionato cambia (Cd per gli articoli, IdComm per le
    // commesse): serve solo a capire quando ricaricare l'elenco file.
    [Parameter] public string? ChiaveSelezione { get; set; }

    private string? ultimaChiave;
    private List<string> File = new();
    private string? FileSelezionato;
    private bool CartellaEsiste;
    private string CartellaPath = "";
    private bool CaricamentoAnteprima;
    private bool CaricamentoUpload;
    private bool ErroreAnteprima;
    private string? TestoAnteprima;

    protected override async Task OnParametersSetAsync()
    {
        if (!string.IsNullOrEmpty(ChiaveSelezione) && ChiaveSelezione != ultimaChiave)
        {
            ultimaChiave = ChiaveSelezione;
            await CaricaFile();
        }
        else if (string.IsNullOrEmpty(ChiaveSelezione))
        {
            ultimaChiave = null;
        }
    }

    private async Task CaricaFile()
    {
        File.Clear();
        FileSelezionato = null;
        CartellaPath = "";
        CartellaEsiste = false;
        CaricamentoAnteprima = false;
        CaricamentoUpload = false;
        ErroreAnteprima = false;
        TestoAnteprima = null;

        if (string.IsNullOrWhiteSpace(Identificatore)) return;

        using var context = await DbFactory.CreateDbContextAsync();
        var basePath = await context.ClassiPaths.AsNoTracking()
            .Where(c => c.IdClasse == IdClasse)
            .Select(c => c.Path)
            .FirstOrDefaultAsync();

        if (string.IsNullOrWhiteSpace(basePath)) return;

        try
        {
            if (!Directory.Exists(basePath)) return;

            // Le cartelle sono nominate <idBrand>_<Identificatore>. Ignoro idBrand quando cerco
            // una cartella gia' esistente: potrebbe essere stata creata con un prefisso storico
            // diverso da quello che useremmo noi oggi.
            var cartellaTrovata = Directory.GetDirectories(basePath)
                .FirstOrDefault(d =>
                {
                    var nome = Path.GetFileName(d);
                    var idx = nome.IndexOf('_');
                    var suffisso = idx >= 0 ? nome[(idx + 1)..] : nome;
                    return string.Equals(suffisso, Identificatore, StringComparison.OrdinalIgnoreCase);
                });

            if (cartellaTrovata != null)
            {
                CartellaPath = cartellaTrovata;
                CartellaEsiste = true;
                File = Directory.GetFiles(CartellaPath)
                    .Select(Path.GetFileName)
                    .Where(f => f != null)
                    .Select(f => f!)
                    .OrderBy(f => f)
                    .ToList();
            }
            else
            {
                // Non esiste ancora: si crea al primo allegato (CaricaNuovoFile), non subito qui,
                // per non riempire il disco di cartelle vuote solo aprendo la scheda di un elemento.
                CartellaPath = Path.Combine(basePath, $"{IdBrand ?? 0}_{Identificatore}");
            }
        }
        catch (IOException)
        {
            CartellaEsiste = false;
        }
        catch (UnauthorizedAccessException)
        {
            CartellaEsiste = false;
        }
    }

    private async Task CaricaNuovoFile(InputFileChangeEventArgs e)
    {
        if (string.IsNullOrEmpty(CartellaPath) || CaricamentoUpload) return;

        CaricamentoUpload = true;
        ErroreAnteprima = false;
        StateHasChanged();

        try
        {
            if (!CartellaEsiste)
            {
                Directory.CreateDirectory(CartellaPath);
                CartellaEsiste = true;
            }

            var browserFile = e.File;
            var destinazione = Path.Combine(CartellaPath, browserFile.Name);

            await using (var stream = browserFile.OpenReadStream(maxAllowedSize: 500L * 1024 * 1024))
            await using (var writer = System.IO.File.Create(destinazione))
            {
                await stream.CopyToAsync(writer);
            }

            File = Directory.GetFiles(CartellaPath)
                .Select(Path.GetFileName)
                .Where(f => f != null)
                .Select(f => f!)
                .OrderBy(f => f)
                .ToList();

            CaricamentoUpload = false;
            await SelezionaFile(browserFile.Name);
        }
        catch
        {
            CaricamentoUpload = false;
            ErroreAnteprima = true;
        }
    }

    private async Task SelezionaFile(string file)
    {
        // Ricliccare lo stesso file gia' selezionato non deve rifare nulla: il browser non
        // "ricarica" un <img>/<video> il cui src non e' cambiato, quindi onload/onloadeddata
        // non scatterebbe piu' e lo spinner (appena riacceso qui sotto) resterebbe bloccato.
        if (file == FileSelezionato && !ErroreAnteprima)
        {
            return;
        }

        FileSelezionato = file;
        ErroreAnteprima = false;
        TestoAnteprima = null;
        CaricamentoAnteprima = false;

        if (ETesto(file))
        {
            try
            {
                TestoAnteprima = System.IO.File.ReadAllText(Path.Combine(CartellaPath, file));
            }
            catch (IOException)
            {
                ErroreAnteprima = true;
            }
            catch (UnauthorizedAccessException)
            {
                ErroreAnteprima = true;
            }
            return;
        }

        if (EAvi(file))
        {
            CaricamentoAnteprima = true;
            StateHasChanged();
            try
            {
                await AviTranscoder.GetMp4Async(Path.Combine(CartellaPath, file));
            }
            catch
            {
                ErroreAnteprima = true;
            }
            finally
            {
                CaricamentoAnteprima = false;
            }
            return;
        }

        if (EOffice(file))
        {
            CaricamentoAnteprima = true;
            StateHasChanged();
            try
            {
                await OfficeConverter.GetPdfAsync(Path.Combine(CartellaPath, file));
            }
            catch
            {
                ErroreAnteprima = true;
            }
            finally
            {
                CaricamentoAnteprima = false;
            }
            return;
        }

        CaricamentoAnteprima = HaAnteprimaDaCaricare(file);
    }

    private async Task ApriInNuovaScheda(string file)
    {
        await JSRuntime.InvokeVoidAsync("open", FileUrl(file), "_blank");
    }

    private void FineCaricamento()
    {
        CaricamentoAnteprima = false;
    }

    private void FineCaricamentoConErrore()
    {
        CaricamentoAnteprima = false;
        ErroreAnteprima = true;
    }

    private static bool HaAnteprimaDaCaricare(string file) =>
        EImmagine(file) || EPdf(file) || EOffice(file) || EVideo(file) || EAudio(file);

    private string FileUrl(string file, bool scarica = false)
    {
        var url = $"/documentale/file?cartella={Uri.EscapeDataString(CartellaPath)}&file={Uri.EscapeDataString(file)}";
        return scarica ? url + "&scarica=true" : url;
    }

    private static bool EImmagine(string file) => Path.GetExtension(file).ToLowerInvariant() is ".jpg" or ".jpeg" or ".png" or ".gif" or ".bmp" or ".webp" or ".svg";

    private static bool EPdf(string file) => Path.GetExtension(file).ToLowerInvariant() == ".pdf";

    private static bool EOffice(string file) => Path.GetExtension(file).ToLowerInvariant() is ".ppt" or ".pptx" or ".doc" or ".docx" or ".odt" or ".xls" or ".xlsx" or ".rtf";

    private static bool EAvi(string file) => Path.GetExtension(file).ToLowerInvariant() == ".avi";

    private static bool EVideo(string file) => Path.GetExtension(file).ToLowerInvariant() is ".mp4" or ".avi" or ".mov" or ".wmv";

    private static bool EAudio(string file) => Path.GetExtension(file).ToLowerInvariant() is ".mp3" or ".wav" or ".ogg";

    private static bool ETesto(string file) => Path.GetExtension(file).ToLowerInvariant() is ".csv" or ".txt";

    private static string IconaFile(string file) => Path.GetExtension(file).ToLowerInvariant() switch
    {
        ".avi" => "Doc_AVI.png",
        ".bmp" => "Doc_BMP.png",
        ".csv" => "Doc_CSV.png",
        ".doc" => "Doc_DOC.png",
        ".docx" => "Doc_DOCX.png",
        ".dwg" => "Doc_DWG.png",
        ".dxf" => "Doc_DXF.png",
        ".jpg" or ".jpeg" => "Doc_JPG.png",
        ".mdl" => "Doc_MDL.png",
        ".mp3" => "Doc_MP3.png",
        ".mp4" => "Doc_MP4.png",
        ".pdf" => "Doc_PDF.png",
        ".png" => "Doc_PNG.png",
        ".xls" => "Doc_XLS.png",
        ".xlsx" => "Doc_XLSX.png",
        _ => "Doc_Generic.svg"
    };

    private static string ContentType(string file) => Path.GetExtension(file).ToLowerInvariant() switch
    {
        ".jpg" or ".jpeg" => "image/jpeg",
        ".png" => "image/png",
        ".gif" => "image/gif",
        ".bmp" => "image/bmp",
        ".webp" => "image/webp",
        ".svg" => "image/svg+xml",
        ".pdf" => "application/pdf",
        ".mp4" or ".avi" => "video/mp4",
        ".mov" => "video/quicktime",
        ".wmv" => "video/x-ms-wmv",
        ".mp3" => "audio/mpeg",
        ".wav" => "audio/wav",
        ".ogg" => "audio/ogg",
        ".csv" => "text/csv",
        ".txt" => "text/plain",
        ".doc" => "application/msword",
        ".docx" => "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
        ".xls" => "application/vnd.ms-excel",
        ".xlsx" => "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
        _ => "application/octet-stream"
    };
}
