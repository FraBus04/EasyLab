@typeparam TItem
@implements IDisposable
@inject IJSRuntime JS
@inject DropdownPortalService Portal

<div class="checkbox-dropdown">
    <div class="checkbox-dropdown-toggle" @ref="toggleRef" @onclick="ToggleDropdown" @onclick:stopPropagation>
        <span class="checkbox-dropdown-text" title="@GetToggleText()">
            @if (SelectedItems.Count == 0)
            {
                @NullText
            }
            else if (SelectedItems.Count == GetAvailableItems().Count())
            {
                <span class="fw-semibold">@SelectAllText</span>
            }
            else
            {
                @string.Join(", ", SelectedItems.Select(GetDisplayText))
            }
        </span>
        <span class="checkbox-dropdown-arrow">
            <svg xmlns="http://www.w3.org/2000/svg" width="10" height="10" fill="currentColor" viewBox="0 0 16 16">
                <path d="M1.646 4.646a.5.5 0 0 1 .708 0L8 10.293l5.646-5.647a.5.5 0 0 1 .708.708l-6 6a.5.5 0 0 1-.708 0l-6-6a.5.5 0 0 1 0-.708z" />
            </svg>
        </span>
    </div>
</div>

@code {
    [Parameter] public IEnumerable<TItem>? Data { get; set; }
    [Parameter] public List<TItem> SelectedItems { get; set; } = new();
    [Parameter] public EventCallback<List<TItem>> SelectedItemsChanged { get; set; }
    [Parameter] public Func<TItem, string>? TextFieldSelector { get; set; }
    [Parameter] public string NullText { get; set; } = "Select...";
    [Parameter] public string SelectAllText { get; set; } = "Select All";

    private ElementReference toggleRef;
    private bool isOpen = false;
    private double menuLeft, menuTop, menuWidth;
    private DotNetObjectReference<CheckboxDropdown<TItem>>? selfRef;

    private bool IsAllSelected => GetAvailableItems().Any() && SelectedItems.Count == GetAvailableItems().Count();

    protected override void OnInitialized()
    {
        CheckboxDropdownInterop.OnCloseAll += HandleCloseAll;
    }

    public void Dispose()
    {
        CheckboxDropdownInterop.OnCloseAll -= HandleCloseAll;
        if (isOpen)
        {
            isOpen = false;
            Portal.Hide();
        }
        selfRef?.Dispose();
        _ = JS.InvokeVoidAsync("checkboxDropdownInterop.unwatchClose");
    }

    private void HandleCloseAll()
    {
        if (isOpen)
        {
            CloseInternal();
            InvokeAsync(StateHasChanged);
        }
    }

    private IReadOnlyList<TItem> GetAvailableItems()
    {
        if (Data == null) return Array.Empty<TItem>();
        return Data as IReadOnlyList<TItem> ?? Data.ToList();
    }

    private string GetDisplayText(TItem item)
    {
        if (TextFieldSelector != null) return TextFieldSelector(item);
        return item?.ToString() ?? "";
    }

    private string GetToggleText()
    {
        if (SelectedItems.Count == 0) return NullText;
        if (SelectedItems.Count == GetAvailableItems().Count()) return SelectAllText;
        return string.Join(", ", SelectedItems.Select(GetDisplayText));
    }

    private async Task ToggleDropdown()
    {
        if (isOpen)
        {
            CloseInternal();
            return;
        }

        CheckboxDropdownInterop.CloseAll();

        var rect = await JS.InvokeAsync<BoundingRect?>("checkboxDropdownInterop.getRect", toggleRef);
        if (rect != null)
        {
            menuLeft = rect.Left;
            menuTop = rect.Top;
            menuWidth = rect.Width;
        }

        isOpen = true;
        Portal.Show(BuildMenu());

        selfRef ??= DotNetObjectReference.Create(this);
        await JS.InvokeVoidAsync("checkboxDropdownInterop.watchClose", selfRef);
    }

    private void CloseInternal()
    {
        isOpen = false;
        Portal.Hide();
        _ = JS.InvokeVoidAsync("checkboxDropdownInterop.unwatchClose");
    }

    [JSInvokable]
    public void OnOutsideScrollOrResize()
    {
        if (!isOpen) return;
        CloseInternal();
        StateHasChanged();
    }

    private void RefreshMenu()
    {
        if (isOpen) Portal.Show(BuildMenu());
    }

    private async Task ToggleSelectAll()
    {
        if (IsAllSelected)
        {
            SelectedItems = new List<TItem>();
        }
        else
        {
            SelectedItems = GetAvailableItems().ToList();
        }
        await SelectedItemsChanged.InvokeAsync(SelectedItems);
        RefreshMenu();
    }

    private async Task ToggleItem(TItem item)
    {
        var list = new List<TItem>(SelectedItems);
        if (list.Contains(item))
        {
            list.Remove(item);
        }
        else
        {
            list.Add(item);
        }
        SelectedItems = list;
        await SelectedItemsChanged.InvokeAsync(SelectedItems);
        RefreshMenu();
    }

    private void OnOverlayClick()
    {
        CheckboxDropdownInterop.CloseAll();
    }

    private string GetMenuStyle()
    {
        var inv = System.Globalization.CultureInfo.InvariantCulture;
        return $"position:fixed; left:{menuLeft.ToString(inv)}px; top:{menuTop.ToString(inv)}px; width:{menuWidth.ToString(inv)}px;";
    }

    private RenderFragment BuildMenu() =>
    @<text>
        <div class="checkbox-dropdown-overlay" @onclick="OnOverlayClick" @onclick:stopPropagation></div>
        <div class="checkbox-dropdown-menu" style="@GetMenuStyle()" @onclick:stopPropagation>
            <div class="checkbox-dropdown-item checkbox-dropdown-select-all" @onclick="ToggleSelectAll">
                <input type="checkbox" checked="@IsAllSelected" @onchange="ToggleSelectAll" @onclick:stopPropagation />
                <span class="fw-bold">@SelectAllText</span>
            </div>
            <div class="checkbox-dropdown-divider"></div>
            @foreach (var item in GetAvailableItems())
            {
                var currentItem = item;
                var isChecked = SelectedItems.Contains(currentItem);
                <div class="checkbox-dropdown-item" @onclick="() => ToggleItem(currentItem)">
                    <input type="checkbox" checked="@isChecked" @onchange="() => ToggleItem(currentItem)" @onclick:stopPropagation />
                    <span>@GetDisplayText(currentItem)</span>
                </div>
            }
        </div>
    </text>;

    private class BoundingRect
    {
        public double Left { get; set; }
        public double Top { get; set; }
        public double Width { get; set; }
    }
}
