                });
            }

            // La SP non filtra per laboratorio: lo applichiamo lato client sul risultato.
            var laboratorioIds = LaboratoriSelezionati.Select(l => l.Id).ToHashSet();
            DataSource = righe.Where(r => r.IdLab != null && laboratorioIds.Contains(r.IdLab.Value)).ToList();
            FasiColonneAttive = Math.Min(FasiSelezionati.Count, 15);
        }
        catch (Exception ex)
        {
