    private async Task Cerca()
    {
        loading = true;
        StateHasChanged();
        try
        {
            var idUte = await GetIdUteAsync();
            if (idUte == null)
            {
                ShowDialog("Errore", "Impossibile determinare l'utente corrente.");
                return;
            }

            using var context = await DbFactory.CreateDbContextAsync();

            // Salva la selezione corrente su Sel_ST: la SP di report legge da lì i filtri da applicare.
            await context.Database.ExecuteSqlInterpolatedAsync(
                $"DELETE FROM Sel_ST WHERE idClasse={IdClasseFasiCommesse} AND idUte={idUte} AND Chiave IN ({ChiaveSelStContatti}, {ChiaveSelStStagioni}, {ChiaveSelStTipoOrdine}, {ChiaveSelStFasi})");

            foreach (var brand in BrandSelezionati)
            {
                await context.Database.ExecuteSqlInterpolatedAsync(
                    $"INSERT INTO Sel_ST (idClasse, idContatto, Chiave, idUte, id) VALUES ({IdClasseFasiCommesse}, 0, {ChiaveSelStContatti}, {idUte}, {brand.Id})");
            }
            foreach (var stagione in StagioneSelezionati)
            {
                await context.Database.ExecuteSqlInterpolatedAsync(
                    $"INSERT INTO Sel_ST (idClasse, idContatto, Chiave, idUte, id) VALUES ({IdClasseFasiCommesse}, 0, {ChiaveSelStStagioni}, {idUte}, {stagione.Id})");
            }
            foreach (var tipoOrdine in TipiOrdineSelezionati)
            {
                await context.Database.ExecuteSqlInterpolatedAsync(
                    $"INSERT INTO Sel_ST (idClasse, idContatto, Chiave, idUte, cd) VALUES ({IdClasseFasiCommesse}, 0, {ChiaveSelStTipoOrdine}, {idUte}, {tipoOrdine.Cod})");
            }
            foreach (var fase in FasiSelezionati)
            {
                await context.Database.ExecuteSqlInterpolatedAsync(
                    $"INSERT INTO Sel_ST (idClasse, idContatto, Chiave, idUte, id) VALUES ({IdClasseFasiCommesse}, 0, {ChiaveSelStFasi}, {idUte}, {fase.IdFase})");
            }

            var connection = context.Database.GetDbConnection();
            await connection.OpenAsync();

            using var cmd = connection.CreateCommand();
            cmd.CommandText = "EXEC [Report].[SP_Produz_GeneCommesse_Testa_AvanzFasi3_CreaSelST] @idClasse, @idUte";
            var pClasse = cmd.CreateParameter();
            pClasse.ParameterName = "@idClasse";
            pClasse.Value = IdClasseFasiCommesse;
            cmd.Parameters.Add(pClasse);
            var pUte = cmd.CreateParameter();
            pUte.ParameterName = "@idUte";
            pUte.Value = idUte;
            cmd.Parameters.Add(pUte);

            var righe = new List<ProduzGeneCommesseAvanzFasiRiga>();
            using var reader = await cmd.ExecuteReaderAsync();
            while (await reader.ReadAsync())
            {
                righe.Add(new ProduzGeneCommesseAvanzFasiRiga
                {
                    IdComm = (int)reader["idComm"],
                    NrScheda = reader["NrScheda"] as int?,
                    OrdTipo = reader["OrdTipo"] as string,
                    AcdAll = reader["A_cdALL"] as string,
                    Parte = reader["Parte"] as string,
                    ParteDesc = reader["ParteDesc"] as string,
                    Mod = reader["Mod"] as string,
                    Tess = reader["Tess"] as string,
                    Nome = reader["Nome"] as string,
                    IdLab = reader["idLab"] as int?,
                    LabDesc = reader["LabDesc"] as string,
                    Saldo = reader["Saldo"] as string,
                    TotCapi = reader["TotCapi"] as int?,
                    TotCapiFin = reader["TotCapiFin"] as int?,
                    PercTotCapiFin = reader["PercTotCapiFin"] as double?,
                    Stato = reader["Stato"] as string,
                    StatoDesc = reader["StatoDesc"] as string,
                    DataRicRientro = reader["DataRicRientro"] as DateTime?,
                    DataConfRientro = reader["DataConfRientro"] as DateTime?,
                    CkConf = reader["ckConf"] as bool?,
                    CkInvMatLogist = reader["ckInvMatLogist"] as bool?,
                    Nota = reader["Nota"] as string,
                    Contatto = reader["Contatto"] as string,
                    StagCod = reader["StagCod"] as string,
                    NrAllegati = reader["NrAllegati"] as int?,
                    FaseCod = reader["FaseCod"] as string,
                    FaseDesc = reader["FaseDesc"] as string,
                    CdValuta = reader["cdValuta"] as string,
                    Prezzo = reader["Prezzo"] as double?,
                    StatoExp = reader["StatoExp"] as string,
                    DataExp = reader["DataExp"] as DateTime?,
                    Forn = reader["Forn"] as string,
                    FornDest = reader["FornDest"] as string,
                    TraspCura = reader["TraspCura"] as string,
                    Vettore = reader["Vettore"] as string,
                    DataComm = reader["DataComm"] is DateTime dataComm ? DateOnly.FromDateTime(dataComm) : (DateOnly?)null,
                    Po = reader["PO"] as string,
                    Pagamento = reader["Pagamento"] as string,
                    StatoApp = reader["StatoApp"] as string,
                    DataApp = reader["DataApp"] as DateTime?,
                    CkPrelTSaldo = (reader["ckPrel_T_Saldo"] as int?) == 1,
                    CkPrelCSaldo = (reader["ckPrel_C_Saldo"] as int?) == 1,
                    CkPrelSaldo = (reader["ckPrel_Saldo"] as int?) == 1,
                    ImgMod = reader["ImgMod"] as byte[],
                    TortaAvanzFasi = reader["TortaAvanzFasi"] as int?,

                    Fase1 = reader["Fase1"] as string,
                    Car1 = reader["Car1"] as int?,
                    Scr1 = reader["Scr1"] as int?,
                    Diff1 = reader["Diff1"] as int?,
                    Fase2 = reader["Fase2"] as string,
                    Car2 = reader["Car2"] as int?,
