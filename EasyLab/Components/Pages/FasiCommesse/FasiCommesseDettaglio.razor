@using EasyLab.Models

@if (CommessaSelezionata != null)
{
    <div class="dettaglio-container">
        <h5 class="dettaglio-titolo">Testata Ordine CF (Commessa)</h5>

        <div class="info-grid info-grid-4">
            <div class="info-field">
                <span class="info-label">Tipo</span>
                <span class="info-value">@CommessaSelezionata.OrdTipo</span>
            </div>
            <div class="info-field">
                <span class="info-label">Data</span>
                <span class="info-value">@CommessaSelezionata.DataComm</span>
            </div>
            <div class="info-field">
                <span class="info-label">Nr Commessa</span>
                <span class="info-value">@CommessaSelezionata.NrScheda</span>
            </div>
            <div class="info-field">
                <span class="info-label">Stato App</span>
                <span class="info-value">@CommessaSelezionata.StatoApp</span>
            </div>
        </div>

        <div class="info-grid info-grid-4 highlight-band">
            <div class="info-field">
                <span class="info-label">Stag</span>
                <span class="info-value">@CommessaSelezionata.StagCod</span>
            </div>
            <div class="info-field">
                <span class="info-label">Modello</span>
                <span class="info-value">@CommessaSelezionata.Mod</span>
            </div>
            <div class="info-field">
                <span class="info-label">Tessuto</span>
                <span class="info-value">@CommessaSelezionata.Tess</span>
            </div>
            <div class="info-field">
                <span class="info-label">Nome</span>
                <span class="info-value">@CommessaSelezionata.Nome</span>
            </div>
        </div>

        <div class="info-grid info-grid-4">
            <div class="info-field">
                <span class="info-label">Stato</span>
                <span class="info-value">@CommessaSelezionata.StatoDesc</span>
            </div>
            <div class="info-field">
                <span class="info-label">Fornitore</span>
                <span class="info-value">@CommessaSelezionata.Forn</span>
            </div>
            <div class="info-field">
                <span class="info-label">Laboratorio</span>
                <span class="info-value">@CommessaSelezionata.LabDesc</span>
            </div>
            <div class="info-field">
                <span class="info-label">Fase Lavorazione</span>
                <span class="info-value">@CommessaSelezionata.FaseDesc</span>
            </div>
        </div>

        <div class="dettaglio-footer">
            <div class="dettaglio-image-wrapper">
                @if (CommessaSelezionata.ImgMod != null)
                {
                    <img src="data:image/png;base64,@Convert.ToBase64String(CommessaSelezionata.ImgMod)" alt="Immagine modello" />
                }
                else
                {
                    <div class="no-image-placeholder">
                        <span>N/D</span>
                    </div>
                }
            </div>
            <div class="dettaglio-nota">
                <span class="info-label">Nota</span>
                <DxMemo Enabled="false" Rows="4" MaxRows="4" Text="@(CommessaSelezionata.Nota ?? "")"></DxMemo>
            </div>
        </div>

        <h5 class="dettaglio-titolo" style="margin-top:24px;">Fasi Lavorazione</h5>

        @if (loadingFasi)
        {
            <Loading></Loading>
        }
        else if (RigheFasi != null)
        {
            <DxGrid Data="@RigheFasi"
                    KeyFieldName="Id"
                    ShowSearchBox="false"
                    ColumnResizeMode="GridColumnResizeMode.NextColumn"
                    PagerVisible="false"
                    VirtualScrollingEnabled="true"
                    Height="280px"
                    CssClass="mb-3"
                    HighlightRowOnHover="true"
                    CustomizeElement="OnFasiCustomizeElement">
                <Columns>
                    <DxGridDataColumn FieldName="Id" Caption="Id" Width="60px" TextAlignment="GridTextAlignment.Center" />
                    <DxGridDataColumn FieldName="OrdPm" Caption="Ord" Width="60px" TextAlignment="GridTextAlignment.Center" />
                    <DxGridDataColumn Caption="Fase Desc" Width="140px">
                        <CellDisplayTemplate Context="ctx">
                            @{
                                var riga = (ProduzGeneCommesseFasiDettaglioRiga)ctx.DataItem;
                            }
                            <div style="display:inline-flex;align-items:center;gap:6px;">
                                @if (!string.IsNullOrEmpty(riga.FaseCol))
                                {
                                    <span style="display:inline-block;width:10px;height:10px;border-radius:50%;background-color:@riga.FaseCol;"></span>
                                }
                                <span>@riga.FaseDesc</span>
                            </div>
                        </CellDisplayTemplate>
                    </DxGridDataColumn>
                    <DxGridDataColumn FieldName="Lab" Caption="Laboratorio" Width="160px" />
                    <DxGridDataColumn FieldName="CkInBol" Caption="Bol" Width="60px" TextAlignment="GridTextAlignment.Center" />
                    <DxGridDataColumn FieldName="DataCarMin" Caption="Data Carico" Width="110px" />
                    <DxGridDataColumn FieldName="DataScrMax" Caption="Data Scarico" Width="110px" />
                    <DxGridDataColumn FieldName="TotCar" Caption="Car" Width="70px" TextAlignment="GridTextAlignment.Center" />
                    <DxGridDataColumn FieldName="TotScr" Caption="Scar" Width="70px" TextAlignment="GridTextAlignment.Center" />
                    <DxGridDataColumn FieldName="TotDiff" Caption="Diff" Width="70px" TextAlignment="GridTextAlignment.Center" />
                    <DxGridDataColumn FieldName="Perc" Caption="%" Width="90px" TextAlignment="GridTextAlignment.Center">
                        <CellDisplayTemplate Context="ctx">
                            @{
                                var riga = (ProduzGeneCommesseFasiDettaglioRiga)ctx.DataItem;
                                var perc = ctx.Value as double? ?? 0;
                                var percClamped = Math.Max(0, Math.Min(100, perc));
                                var (coloreChiaro, coloreScuro) = GetColoriSaldoFase(riga.CkSaldo);
                            }
                            <div style="display:inline-flex;align-items:center;gap:4px;">
                                <div style="width:50px;height:10px;border-radius:5px;background:@coloreChiaro;overflow:hidden;">
                                    <div style="width:@(percClamped.ToString(System.Globalization.CultureInfo.InvariantCulture))%;height:100%;background-color:@coloreScuro;"></div>
                                </div>
                                <span style="font-size:0.75rem;">@perc.ToString("N0")%</span>
                            </div>
                        </CellDisplayTemplate>
                    </DxGridDataColumn>
                    <DxGridDataColumn FieldName="CkSaldo" Caption="Saldo" Width="60px" TextAlignment="GridTextAlignment.Center" />
                    <DxGridDataColumn FieldName="Gg" Caption="GG" Width="60px" TextAlignment="GridTextAlignment.Center" />
                    <DxGridDataColumn FieldName="DateDaDes" Caption="Data Da" Width="100px" />
                    <DxGridDataColumn FieldName="DateADes" Caption="Data A" Width="100px">
                        <CellDisplayTemplate Context="ctx">
                            @{
                                var riga = (ProduzGeneCommesseFasiDettaglioRiga)ctx.DataItem;
                            }
                            @if (riga.CkSaldo != true)
                            {
                                @ctx.Value
                            }
                        </CellDisplayTemplate>
                    </DxGridDataColumn>
                    <DxGridDataColumn FieldName="CkConfRientro" Caption="Conf" Width="60px" TextAlignment="GridTextAlignment.Center" />
                </Columns>
            </DxGrid>
        }

        <div class="dettaglio-divider"></div>

        @if (loadingTotali)
        {
            <Loading></Loading>
        }
        else if (RigheTotali != null)
        {
            <DxGrid Data="@RigheTotali"
                    KeyFieldName="Id"
                    ShowSearchBox="false"
                    ColumnResizeMode="GridColumnResizeMode.NextColumn"
                    PagerVisible="false"
                    VirtualScrollingEnabled="true"
                    Height="280px"
                    HighlightRowOnHover="true">
                <Columns>
                    <DxGridDataColumn FieldName="CodCol" Caption="Cod" Width="90px" />
                    <DxGridDataColumn FieldName="DescCol" Caption="Colore" Width="150px" />
                    <DxGridDataColumn Caption="Img" Width="60px" AllowSort="false">
                        <CellDisplayTemplate Context="ctx">
                            @{
                                var riga = (ProduzGeneOrdDaProdurreTotaliRiga)ctx.DataItem;
                            }
                            @if (riga.ImgModCol != null)
                            {
                                <img src="data:image/png;base64,@Convert.ToBase64String(riga.ImgModCol)" style="height:28px;width:28px;object-fit:cover;border-radius:4px;" />
                            }
                        </CellDisplayTemplate>
                    </DxGridDataColumn>
                    <DxGridDataColumn FieldName="TotCapi" Caption="Tot. Col" Width="80px" TextAlignment="GridTextAlignment.Center" />
                    @for (var i = 1; i <= 16; i++)
                    {
                        var idx = i;
                        <DxGridDataColumn FieldName="@($"Nr{idx}")" Caption="@GetTagliaCaption(idx)" Width="60px" TextAlignment="GridTextAlignment.Center" Visible="@TagliaPerPosizione.ContainsKey(idx)" />
                    }
                </Columns>
                <TotalSummary>
                    <DxGridSummaryItem SummaryType="GridSummaryItemType.Sum" FieldName="TotCapi" FooterColumnName="TotCapi" DisplayFormat="{0:N0}" />
                    @for (var i = 1; i <= 16; i++)
                    {
                        var idx = i;
                        <DxGridSummaryItem SummaryType="GridSummaryItemType.Sum" FieldName="@($"Nr{idx}")" FooterColumnName="@($"Nr{idx}")" DisplayFormat="{0:N0}" />
                    }
                </TotalSummary>
            </DxGrid>
        }
    </div>
}
else
{
    <div class="d-flex align-items-center justify-content-center text-muted" style="height: 120px;">
        <p class="mb-0">Seleziona una commessa dall'elenco per vedere il dettaglio.</p>
    </div>
}

@code {
    [Parameter]
    public ProduzGeneCommesseAvanzFasiRiga? CommessaSelezionata { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private List<ProduzGeneOrdDaProdurreTotaliRiga>? RigheTotali;
    private List<ProduzGeneCommesseFasiDettaglioRiga>? RigheFasi;
    private Dictionary<int, string> TagliaPerPosizione = new();
    private bool loadingTotali;
    private bool loadingFasi;
    private int? _idCommCaricato;

    private string GetTagliaCaption(int posizione) =>
        TagliaPerPosizione.TryGetValue(posizione, out var tg) ? tg : $"Tg {posizione}";

    private static (string Chiaro, string Scuro) GetColoriSaldoFase(bool? saldo) => saldo == true
        ? ("#d4edda", "#28a745")
        : ("#fff3cd", "#e6ac00");

    private void OnFasiCustomizeElement(GridCustomizeElementEventArgs e)
    {
        if (e.ElementType == GridElementType.DataRow)
        {
            var riga = e.Grid.GetDataItem(e.VisibleIndex) as ProduzGeneCommesseFasiDettaglioRiga;
            if (riga?.CkSaldo == true)
            {
                e.CssClass = "fase-row-saldata";
            }
        }
    }

    private async Task<int?> GetIdUteAsync()
    {
        if (AuthStateTask == null) return null;

        var authState = await AuthStateTask;
        var utente = await UserManager.GetUserAsync(authState.User);
        return utente?.idEasyPLM;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (CommessaSelezionata == null)
        {
            _idCommCaricato = null;
            RigheTotali = null;
            RigheFasi = null;
            TagliaPerPosizione = new();
            return;
        }

        if (_idCommCaricato == CommessaSelezionata.IdComm)
        {
            return;
        }

        _idCommCaricato = CommessaSelezionata.IdComm;
        RigheTotali = null;
        RigheFasi = null;
        loadingTotali = true;
        loadingFasi = true;
        StateHasChanged();

        try
        {
            using var context = await DbFactory.CreateDbContextAsync();
            var connection = context.Database.GetDbConnection();
            await connection.OpenAsync();

            var idUte = await GetIdUteAsync();
            if (idUte != null)
            {
                using var cmdFasi = connection.CreateCommand();
                cmdFasi.CommandText = "EXEC [dbo].[SP_Produz_GeneCommesseFasi_Ricalcola_idComm] @idComm, @idUte";
                var pIdComm = cmdFasi.CreateParameter();
                pIdComm.ParameterName = "@idComm";
                pIdComm.Value = CommessaSelezionata.IdComm;
                cmdFasi.Parameters.Add(pIdComm);
                var pIdUte = cmdFasi.CreateParameter();
                pIdUte.ParameterName = "@idUte";
                pIdUte.Value = idUte.Value;
                cmdFasi.Parameters.Add(pIdUte);

                var righeFasi = new List<ProduzGeneCommesseFasiDettaglioRiga>();
                using var readerFasi = await cmdFasi.ExecuteReaderAsync();
                while (await readerFasi.ReadAsync())
                {
                    righeFasi.Add(new ProduzGeneCommesseFasiDettaglioRiga
                    {
                        Id = (int)readerFasi["id"],
                        IdComm = readerFasi["idComm"] as int?,
                        IdMod = readerFasi["idMod"] as int?,
                        ACdAll = readerFasi["A_cdALL"] as string,
                        IdFase = readerFasi["idFase"] as int?,
                        IdForn = readerFasi["idForn"] as int?,
                        Um = readerFasi["UM"] as string,
                        Qt = readerFasi["Qt"] == DBNull.Value ? null : Convert.ToDouble(readerFasi["Qt"]),
                        OrdPm = readerFasi["OrdPM"] as int?,
                        Tempo = readerFasi["Tempo"] == DBNull.Value ? null : Convert.ToDouble(readerFasi["Tempo"]),
                        Prz = readerFasi["Prz"] == DBNull.Value ? null : Convert.ToDouble(readerFasi["Prz"]),
                        TotCar = readerFasi["TotCAR"] as int?,
                        TotScr = readerFasi["TotSCR"] as int?,
                        TotDiff = readerFasi["TotDIFF"] as int?,
                        CkSaldo = readerFasi["ckSaldo"] as bool?,
                        CkInBol = readerFasi["ckInBol"] as bool?,
                        CkConfRientro = readerFasi["ckConfRientro"] as bool?,
                        DateDaDes = readerFasi["DateDaDes"] is DateTime dDa ? DateOnly.FromDateTime(dDa) : (DateOnly?)null,
                        DateADes = readerFasi["DateADes"] is DateTime dA ? DateOnly.FromDateTime(dA) : (DateOnly?)null,
                        Perc = readerFasi["Perc"] == DBNull.Value ? null : Convert.ToDouble(readerFasi["Perc"]),
                        Tipo = readerFasi["TIPO"] as string,
                        FaseCod = readerFasi["FaseCod"] as string,
                        FaseDesc = readerFasi["FaseDesc"] as string,
                        Lab = readerFasi["Lab"] as string,
                        Gg = readerFasi["GG"] as int?,
                        FaseCol = readerFasi["FaseCol"] as string,
                        CkFaseCar = readerFasi["ckFaseCar"] as bool?,
                        DataCarMin = readerFasi["DataCarMin"] is DateTime dCar ? DateOnly.FromDateTime(dCar) : (DateOnly?)null,
                        DataScrMax = readerFasi["DataScrMax"] is DateTime dScr ? DateOnly.FromDateTime(dScr) : (DateOnly?)null,
                    });
                }
                await readerFasi.CloseAsync();
                RigheFasi = righeFasi;
            }
            loadingFasi = false;
            StateHasChanged();

            using var cmd = connection.CreateCommand();
            cmd.CommandText = "EXEC [Report].[SP_Produz_GeneOrd_DaProdurre_Totali_Select_id] @id";
            var p = cmd.CreateParameter();
            p.ParameterName = "@id";
            p.Value = CommessaSelezionata.IdComm;
            cmd.Parameters.Add(p);

            var righe = new List<ProduzGeneOrdDaProdurreTotaliRiga>();
            using var reader = await cmd.ExecuteReaderAsync();
            while (await reader.ReadAsync())
            {
                righe.Add(new ProduzGeneOrdDaProdurreTotaliRiga
                {
                    Id = (int)reader["id"],
                    IdContatto = reader["idContatto"] as int?,
                    IdComm = reader["idComm"] as int?,
                    NrCommessa = reader["NrCommessa"] as int?,
                    IdStag = reader["idStag"] as int?,
                    IdMod = reader["idMod"] as int?,
                    IdModCol = reader["idModCol"] as int?,
                    Mod = reader["Mod"] as string,
                    Tess = reader["Tess"] as string,
                    CodCol = reader["CodCol"] as string,
                    DescCol = reader["DescCol"] as string,
                    ImgModCol = reader["imgModCol"] as byte[],
                    TotCapi = reader["TotCapi"] as int?,
                    Nr1 = reader["Nr1"] as int?,
                    Nr2 = reader["Nr2"] as int?,
                    Nr3 = reader["Nr3"] as int?,
                    Nr4 = reader["Nr4"] as int?,
                    Nr5 = reader["Nr5"] as int?,
                    Nr6 = reader["Nr6"] as int?,
                    Nr7 = reader["Nr7"] as int?,
                    Nr8 = reader["Nr8"] as int?,
                    Nr9 = reader["Nr9"] as int?,
                    Nr10 = reader["Nr10"] as int?,
                    Nr11 = reader["Nr11"] as int?,
                    Nr12 = reader["Nr12"] as int?,
                    Nr13 = reader["Nr13"] as int?,
                    Nr14 = reader["Nr14"] as int?,
                    Nr15 = reader["Nr15"] as int?,
                    Nr16 = reader["Nr16"] as int?,
                });
            }
            await reader.CloseAsync();
            RigheTotali = righe;

            // Nr1..Nr16 sono posizionali: recuperiamo le etichette taglia dal set usato dai movimenti di questa commessa
            // (stesso meccanismo usato in SintesiMovimenti.razor).
            var idSet = await context.Database.SqlQuery<int?>(
                $"SELECT TOP 1 idSet AS Value FROM doc.Doc3 WHERE idClasseDoc = 129 AND idComm = {CommessaSelezionata.IdComm} AND idSet IS NOT NULL")
                .FirstOrDefaultAsync();

            if (idSet != null)
            {
                var taglie = await context.SetTaglieDetts.AsNoTracking()
                    .Where(s => s.IdSetTaglie == idSet && s.Ord != null)
                    .ToListAsync();
                TagliaPerPosizione = taglie.ToDictionary(t => t.Ord!.Value, t => t.Tg);
            }
            else
            {
                TagliaPerPosizione = new();
            }
        }
        finally
        {
            loadingTotali = false;
            loadingFasi = false;
            StateHasChanged();
        }
    }
}
