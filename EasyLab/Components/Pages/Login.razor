@page "/login"
@layout EasyLab.Components.Layout.LoginLayout
@rendermode InteractiveServer
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Login | EasyPLM</PageTitle>

<div class="login-container">
    <div class="login-overlay"></div>

    <div class="login-card">
        <div class="login-logo-container">
            <img src="/images/EasyLab.png" alt="EasyLab Logo" class="login-logo" />
        </div>

        <h3 class="login-title">EasyLab WebApp</h3>

        <form method="post" action="/auth/login">
            <AntiforgeryToken />

            <div class="form-group">
                <label for="username" class="form-label">Username</label>
                <input type="text" id="username" name="username" class="form-control" placeholder="Username" autofocus />
            </div>

            <div class="form-group">
                <label for="password" class="form-label">Password</label>
                <input type="password" id="password" name="password" class="form-control" placeholder="••••••••" />
            </div>

            @if (MostraErrore)
            {
                <div class="error-message">Username o password non validi.</div>
            }

            <div class="login-actions">
                <button type="submit" class="btn-login">Accedi</button>
                <button type="reset" class="btn-clear">Pulisci</button>
            </div>
        </form>

        <div class="footer-text">
            © 2026 EasyPLM - Digital Transformation for Fashion
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    private string? ErroreQuery { get; set; }

    private bool MostraErrore => !string.IsNullOrEmpty(ErroreQuery);

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (authState.User.Identity?.IsAuthenticated == true)
        {
            Navigation.NavigateTo("/");
        }
    }
}
