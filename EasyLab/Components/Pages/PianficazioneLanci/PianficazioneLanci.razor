    private async Task ApplicaPermessiLettura()
    {
        if (AuthStateTask == null) return;

        var authState = await AuthStateTask;
        var utenteId = UserManager.GetUserId(authState.User);
        if (utenteId == null) return;

        // Una riga senza permesso esplicito NON è visibile: serve un permesso con Visualizza = true.
        var visibili = await DbContext.PermessiLetturaTabelles.AsNoTracking()
            .Where(p => p.UtenteId == utenteId && p.Visualizza
                && (p.TabellaId == IdTabellaStagioni || p.TabellaId == IdTabellaBrand || p.TabellaId == IdTabellaLaboratori || p.TabellaId == IdTabellaTipo))
            .ToListAsync();

        var brandVisibili = visibili.Where(p => p.TabellaId == IdTabellaBrand).Select(p => p.RigaCod).ToHashSet();
        var stagioniVisibili = visibili.Where(p => p.TabellaId == IdTabellaStagioni).Select(p => p.RigaCod).ToHashSet();
        var laboratoriVisibili = visibili.Where(p => p.TabellaId == IdTabellaLaboratori).Select(p => p.RigaCod).ToHashSet();
        var tipiVisibili = visibili.Where(p => p.TabellaId == IdTabellaTipo).Select(p => p.RigaCod).ToHashSet();

        Brands = Brands.Where(b => brandVisibili.Contains(b.Id.ToString())).ToList();
        Stagioni = Stagioni.Where(s => stagioniVisibili.Contains(s.Id.ToString())).ToList();
        Laboratori = Laboratori.Where(l => laboratoriVisibili.Contains(l.Id.ToString())).ToList();
        TipiDisponibili = TipiDisponibili.Where(t => tipiVisibili.Contains(t)).ToList();
    }

