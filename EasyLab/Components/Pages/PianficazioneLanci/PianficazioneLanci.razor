    private async Task CercaLibera()
    {
        loadingLibera = true;
        StateHasChanged();
        try
        {
            using var context = await DbFactory.CreateDbContextAsync();
            var connection = context.Database.GetDbConnection();
            await connection.OpenAsync();

            using var cmd = connection.CreateCommand();
            var whereClauses = new List<string> { "Stato = 'A'" };
            var paramIndex = 0;

            void AddInClause(string column, IEnumerable<object> values)
            {
                var valueList = values.ToList();
                if (valueList.Count == 0)
                {
                    whereClauses.Add("1=0");
                    return;
                }
                var names = new List<string>();
                foreach (var v in valueList)
                {
                    var pname = $"@p{paramIndex++}";
                    names.Add(pname);
                    var p = cmd.CreateParameter();
                    p.ParameterName = pname;
                    p.Value = v;
                    cmd.Parameters.Add(p);
                }
                whereClauses.Add($"{column} IN ({string.Join(",", names)})");
            }

            AddInClause("TIPO", TipiSelezionatiLibera.Cast<object>());
            AddInClause("idContatto", BrandSelezionatiLibera.Select(b => (object)b.Id));
            AddInClause("idStag", StagioneSelezionatiLibera.Select(s => (object)s.Id));

            cmd.CommandText = "SELECT cd, TIPO, idContatto, Contatto, Stag, Parte, ParteDesc, idStag, CodArtFornitore, "
                + "dbo.GET_Immagine_cdALL1(cd) AS imgParte1 FROM V_BasiALL WHERE "
                + string.Join(" AND ", whereClauses) + " ORDER BY Parte";

            var righe = new List<BasiAllLiberaRiga>();
            using var reader = await cmd.ExecuteReaderAsync();
            while (await reader.ReadAsync())
            {
                righe.Add(new BasiAllLiberaRiga
                {
                    Cd = reader["cd"] as string,
                    Tipo = reader["TIPO"] as string,
                    Stag = reader["Stag"] as string,
                    Parte = reader["Parte"] as string,
                    ParteDesc = reader["ParteDesc"] as string,
                    CodArtFornitore = reader["CodArtFornitore"] as string,
                    Contatto = reader["Contatto"] as string,
                    ImgParte1 = reader["imgParte1"] as byte[],
                });
            }
            DataSourceLibera = righe;
        }
        catch (Exception ex)
        {
            await ShowDialog("Errore", $"Si è verificato un errore durante la ricerca: {ex.Message}", ("OK", "ok", ButtonRenderStyle.Primary));
        }
        finally
        {
            loadingLibera = false;
            StateHasChanged();
        }
    }

