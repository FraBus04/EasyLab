            entity.CkConf = editModel.CkConf;
            entity.Nota = editModel.Nota;
            entity.TotCapiFin = editModel.TotCapiFin;
            entity.TotQtaFin = editModel.TotQtaFin;
            entity.Stato = editModel.Stato;
            entity.DataUpd = DateTime.Now;

            await context.SaveChangesAsync();
            await CaricaDati();
        }
        catch (Exception ex)
        {
            e.Cancel = true;
            await ShowDialog("Errore", $"Si è verificato un errore durante il salvataggio: {ex.Message}", ("OK", "ok", ButtonRenderStyle.Primary));
        }
        finally
        {
            loading = false;
            StateHasChanged();
        }
    }

    private static string GetTipoLabel(string tipo) => tipo switch
    {
        "PR" => "Prodotti",
        "MP" => "Materiali",
        "SM" => "Semilavorati",
        _ => tipo
    };
}
