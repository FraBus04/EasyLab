    private async Task CaricaDati()
    {
        using var context = await DbFactory.CreateDbContextAsync();
        var query = context.VProduzGeneCommesseTesta2s.AsNoTracking()
            .Where(a => TipiSelezionati.Contains(a.Tipo));

        var brandIds = BrandSelezionati.Select(b => b.Id).ToList();
        query = query.Where(a => brandIds.Contains(a.IdContatto));

        var stagioneIds = StagioneSelezionati.Select(s => s.Id).ToList();
        query = query.Where(a => stagioneIds.Contains(a.IdStag));

        var laboratorioIds = LaboratoriSelezionati.Select(l => l.Id).ToList();
        query = query.Where(a => laboratorioIds.Contains(a.IdLab));

        var ordTipoCodes = TipiOrdineSelezionati.Select(t => t.Cod).ToList();
        query = query.Where(a => ordTipoCodes.Contains(a.OrdTipo));

        DataSource = await query.OrderByDescending(a => a.NrScheda).ToListAsync();

        if (CommessaSelezionata != null)
        {
            CommessaSelezionata = DataSource.FirstOrDefault(x => x.Id == CommessaSelezionata.Id);
        }
    }

