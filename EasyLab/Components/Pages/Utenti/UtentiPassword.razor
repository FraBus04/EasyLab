@inject NavigationManager Navigation

@if (Utente == null)
{
    <div class="d-flex align-items-center justify-content-center text-muted" style="height: 200px;">
        <p class="mb-0">Seleziona un utente dall'elenco per reimpostarne la password.</p>
    </div>
}
else
{
    <div class="utente-card" style="max-width: 480px;">
        <div class="fw-bold fs-5">Password di @Utente.UserName</div>

        @if (loading)
        {
            <Loading></Loading>
        }
        else
        {
            <div class="detail-section">
                <div class="form-group mb-3">
                    <label class="form-label">Nuova password</label>
                    <input type="password" @bind="NuovaPassword" @bind:event="oninput" class="form-control" />
                </div>
                <div class="form-group mb-3">
                    <label class="form-label">Conferma nuova password</label>
                    <input type="password" @bind="ConfermaPassword" @bind:event="oninput" class="form-control" />
                </div>

                <DxButton Text="Aggiorna password"
                          RenderStyle="ButtonRenderStyle.Primary"
                          Click="SalvaPassword" />

                @if (!string.IsNullOrEmpty(Messaggio))
                {
                    <div class="mt-2 @(Errore ? "text-danger" : "text-success")" style="font-size:0.85rem;">@Messaggio</div>
                }
            </div>
        }
    </div>
}

@code {
    [Parameter] public ApplicationUser? Utente { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private string NuovaPassword = "";
    private string ConfermaPassword = "";
    private string? _previousUtenteId;
    private bool loading;
    private string? Messaggio;
    private bool Errore;

    protected override void OnParametersSet()
    {
        if (Utente?.Id != _previousUtenteId)
        {
            _previousUtenteId = Utente?.Id;
            NuovaPassword = "";
            ConfermaPassword = "";
            Messaggio = null;
        }
    }

    private async Task SalvaPassword()
    {
        if (Utente == null) return;

        Messaggio = null;
        Errore = false;

        if (string.IsNullOrWhiteSpace(NuovaPassword) || NuovaPassword != ConfermaPassword)
        {
            Messaggio = "Le due password non coincidono.";
            Errore = true;
            return;
        }

        loading = true;
        StateHasChanged();
        try
        {
            var utente = await UserManager.FindByIdAsync(Utente.Id);
            if (utente == null)
            {
                Messaggio = "Utente non trovato.";
                Errore = true;
                return;
            }

            if (string.IsNullOrEmpty(utente.SecurityStamp))
            {
                await UserManager.UpdateSecurityStampAsync(utente);
            }

            await UserManager.RemovePasswordAsync(utente);
            var result = await UserManager.AddPasswordAsync(utente, NuovaPassword);

            if (!result.Succeeded)
            {
                Messaggio = string.Join(" ", result.Errors.Select(err => err.Description));
                Errore = true;
                return;
            }
                                                                            
            NuovaPassword = "";
            ConfermaPassword = "";
            Messaggio = "Password aggiornata correttamente.";

            if (AuthStateTask != null)
            {
                var authState = await AuthStateTask;
                var idUtenteCorrente = UserManager.GetUserId(authState.User);
                if (idUtenteCorrente == utente.Id)
                {
                    var returnUrl = Uri.EscapeDataString("/login?pwdchanged=1");
                    Navigation.NavigateTo($"/auth/logout?returnUrl={returnUrl}", forceLoad: true);
                }
            }
        }
        catch (Exception ex)
        {
            Messaggio = $"Si è verificato un errore: {ex.Message}";
            Errore = true;
        }
        finally
        {
            loading = false;
            StateHasChanged();
        }
    }
}
