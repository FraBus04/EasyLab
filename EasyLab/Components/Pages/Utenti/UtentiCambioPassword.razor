<div class="d-flex justify-content-center pt-4">
    <div class="utente-card" style="max-width: 480px; width: 100%;">
        <div class="fw-bold fs-5 mb-3">Cambio Password</div>

        @if (Successo)
        {
            <div class="alert alert-success">Password aggiornata correttamente.</div>
        }
        @if (Errore)
        {
            <div class="alert alert-danger">@MessaggioErrore</div>
        }

        <form method="post" action="/auth/change-password">
            <AntiforgeryToken />

            <div class="form-group mb-3">
                <label class="form-label">Password attuale</label>
                <input type="password" name="currentPassword" class="form-control" required />
            </div>

            <div class="form-group mb-3">
                <label class="form-label">Nuova password</label>
                <input type="password" name="newPassword" class="form-control" required />
            </div>

            <div class="form-group mb-3">
                <label class="form-label">Conferma nuova password</label>
                <input type="password" name="confirmPassword" class="form-control" required />
            </div>

            <button type="submit" class="btn btn-primary">Aggiorna password</button>
        </form>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "pwdsuccess")]
    private string? PwdSuccess { get; set; }

    [SupplyParameterFromQuery(Name = "pwderror")]
    private string? PwdErrore { get; set; }

    private bool Successo => !string.IsNullOrEmpty(PwdSuccess);
    private bool Errore => !string.IsNullOrEmpty(PwdErrore);

    private string MessaggioErrore => PwdErrore switch
    {
        "mismatch" => "La nuova password e la conferma non coincidono.",
        _ => "Password attuale errata o nuova password non valida (min. 6 caratteri, con maiuscola, minuscola, cifra e carattere speciale)."
    };
}
