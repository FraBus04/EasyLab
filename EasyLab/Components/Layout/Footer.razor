@rendermode InteractiveServer
@using EasyLab.Models
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<SeaseTstContext> dbContextFactory

<footer class="Footer">
    <div class="Footer-Container-Left">
        <div class="footer-item">
            <img src="/images/bouser_16x16.png" alt="User" />
            <AuthorizeView>
                <Authorized>
                    <span>@context.User.Identity?.Name</span>
                </Authorized>
            </AuthorizeView>
        </div>
        <div class="footer-item">
            <img src="/images/managedatasource_16x16.png" alt="DB" />
            <span>@NomeDatabase</span>
        </div>
    </div>

    <div class="Footer-Container-Right">
        <span>Versione: </span>
        <span>0.0.0</span>
    </div>
</footer>

@code {
    string? NomeDatabase;

    protected override void OnInitialized()
    {
        using var dbContext = dbContextFactory.CreateDbContext();
        NomeDatabase = dbContext.Database.GetDbConnection().Database;
    }
}
