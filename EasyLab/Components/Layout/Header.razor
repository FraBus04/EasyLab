@inject NavigationManager NavManager
@inject IJSRuntime JSRuntime
@using Microsoft.Extensions.Localization
@rendermode InteractiveServer

<header class="Header">
	<div class="Header-Container">
		<div @onclick="Home">
			<img style="cursor: pointer; width: auto; height: auto;" src="/images/EASY-20-60.png" alt="Home" />
		</div>
		<div @onclick="Materiali">
			<button>
                <img src="/images/MatSVG.svg" alt="Materiali" />
			</button>
			<span>Materiali</span>
		</div>
		<div @onclick="Prodotti">
			<button>
                <img src="/images/SchedaProdottoSVG.svg" alt="Prodotti" />
			</button>
			<span>Prodotti</span>
		</div> 
		@* <div @onclick="DiBa">
			<button>
				<img src="/images/DiBaSVG.svg" alt="DiBa" />
			</button>
			<span>DiBa</span>
		</div> *@
        <div @onclick="PianficazioneLanci">
            <button>
                <img src="/images/ProduzioneSVG.svg" alt="Pianficazione Lanci" />
            </button>
            <span>Pianficazione Lanci</span>
        </div>
        <div @onclick="Utenti">
            <button>
                <img src="/images/UteSWG.svg" alt="Utenti" />
            </button>
            <span>Gestione Utenti</span>
        </div>
        <form method="post" action="/auth/logout" class="Header-Logout">
            <AntiforgeryToken />
            <button type="submit" title="Logout">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="currentColor" viewBox="0 0 16 16">
                    <path fill-rule="evenodd" d="M6 3.5a.5.5 0 0 1 .5-.5h8a.5.5 0 0 1 .5.5v9a.5.5 0 0 1-.5.5h-8a.5.5 0 0 1-.5-.5v-2a.5.5 0 0 0-1 0v2A1.5 1.5 0 0 0 6.5 14h8a1.5 1.5 0 0 0 1.5-1.5v-9A1.5 1.5 0 0 0 14.5 2h-8A1.5 1.5 0 0 0 5 3.5v2a.5.5 0 0 0 1 0v-2z" />
                    <path fill-rule="evenodd" d="M11.854 8.354a.5.5 0 0 0 0-.708l-3-3a.5.5 0 1 0-.708.708L10.293 7.5H1.5a.5.5 0 0 0 0 1h8.793l-2.147 2.146a.5.5 0 0 0 .708.708l3-3z" />
                </svg>
            </button>
            <span>Logout</span>
        </form>
	</div>
</header>

@code {
    private async Task CreaUtente(MouseEventArgs e)
    {
        if (e.ShiftKey)
        {
            await JSRuntime.InvokeVoidAsync("open", "/utenti/crea", "_blank");
        }
        else
        {
            NavManager.NavigateTo("/utenti/crea");
        }
    }

